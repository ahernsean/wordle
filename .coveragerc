# Coverage configuration for the Wordle solver.
#
# Scope: the game, engine/kernel, caches, swarm workers, cache sync utilities,
# and shared runtime/UI helpers.  Operator and reporting modules are covered by
# the staged production-coverage backfill tracked in #316.
# Out of scope: test support, the verify_*.py re-verification and audit passes,
# and the one-off diagnostic and dataset scripts.
[run]
branch = True
# CI splits the suite across three jobs and combines their data files, so each
# job legitimately leaves some source modules unimported.  The per-job warning
# says nothing about coverage of the combined run, and lands next to the test
# summary where it reads as part of a failure.
disable_warnings = module-not-imported
source =
    wordle
    wordle_engine
    pattern_matrix
    erd_lattice
    cache_sqlite
    hint_cache
    erd_swarm
    erd_queue
    runtime_paths
    wordle_ui
    export_cache
    import_cache

[report]
# Schema migrations are deliberately uncovered: they run once against legacy
# databases and are guarded so they are skipped on every subsequent open.
exclude_lines =
    pragma: no cover
    pragma: migration
    if __name__ == .__main__.:
    raise NotImplementedError
    def __repr__
show_missing = True
precision = 1
