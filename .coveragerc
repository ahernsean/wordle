# Coverage configuration for the Wordle solver.
#
# Scope: application core (wordle.py, wordle_engine.py, cache_sqlite.py),
# parallel ERD precache coordination (erd_swarm.py, erd_queue.py), and the
# cache sync utilities (export_cache.py, import_cache.py).
# Out of scope: erd_search.py (supervisor/process-spawn/terminal CLI layer),
# verify_erd_cache.py, and the one-off diagnostic and dataset scripts.
[run]
branch = True
source =
    wordle
    wordle_engine
    cache_sqlite
    erd_swarm
    erd_queue
    export_cache
    import_cache

[report]
# Schema migrations are deliberately uncovered: they run once against legacy
# databases and are guarded so they are skipped on every subsequent open.
exclude_lines =
    pragma: no cover
    pragma: migration
    if __name__ == .__main__.:
    raise NotImplementedError
    def __repr__
show_missing = True
precision = 1
